# Copie para .env e preencha. Nunca publique o .env.
PORT=3000
NODE_ENV=production

# Chave usada para assinar os logins. Gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Quem se cadastrar com este e-mail vira administrador
ADMIN_EMAIL=voce@exemplo.com

# Endereços autorizados a chamar a API (separados por vírgula). Vazio libera todos.
# Para o app Android (Capacitor) inclua: https://localhost,capacitor://localhost
CORS_ORIGINS=

# Onde o banco SQLite fica salvo
DB_FILE=./data/app.db
